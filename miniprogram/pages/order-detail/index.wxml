<!-- ===== 状态头部 ===== -->
<view class="status-header">
  <view class="status-top">
    <view class="status-left">
      <text class="status-badge status-{{order.status}}">{{order.statusLabel}}</text>
      <text class="order-id">#{{order.id}}</text>
    </view>
    <text class="order-urgency urgency-{{order.urgency}}">{{order.urgencyLabel}}</text>
  </view>

  <!-- 进度条 -->
  <view class="progress-wrapper">
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{order.progress}}%; background: {{order.barColor}};"></view>
    </view>
    <text class="progress-text">进度 {{order.progress}}%</text>
  </view>
</view>

<!-- ===== 设备/地址信息 ===== -->
<view class="info-card">
  <view class="info-title">📍 设备信息</view>
  <view class="info-grid">
    <view class="info-item">
      <text class="info-label">设备类型</text>
      <text class="info-value">{{order.category || '未指定'}}</text>
    </view>
    <view class="info-item">
      <text class="info-label">品牌</text>
      <text class="info-value">{{order.brand || '未指定'}}</text>
    </view>
    <view class="info-item">
      <text class="info-label">型号</text>
      <text class="info-value">{{order.model || '未指定'}}</text>
    </view>
    <view class="info-item">
      <text class="info-label">报修地址</text>
      <text class="info-value">{{order.address || order.location || '未指定'}}</text>
    </view>
  </view>
</view>

<!-- ===== 工单信息 ===== -->
<view class="info-card">
  <view class="info-title">📋 工单信息</view>
  <view class="info-row">
    <text class="info-label">报修标题</text>
    <text class="info-value">{{order.title}}</text>
  </view>
  <view class="info-row">
    <text class="info-label">故障描述</text>
    <text class="info-value">{{order.description || '暂无描述'}}</text>
  </view>
  <view class="info-row">
    <text class="info-label">联系人</text>
    <text class="info-value">{{order.contactName || '未填写'}} {{order.contactPhone || ''}}</text>
  </view>
  <view class="info-row">
    <text class="info-label">提交时间</text>
    <text class="info-value">{{order.createdAt}}</text>
  </view>
</view>

<!-- ===== 状态时间轴 ===== -->
<view class="timeline-card">
  <view class="info-title">⏳ 进度追踪</view>
  <view class="timeline">
    <view class="timeline-item" wx:for="{{order.timeline}}" wx:key="label">
      <!-- 节点圆点 -->
      <view class="timeline-dot {{item.done ? 'done' : 'pending'}}">
        <text wx:if="{{item.done}}">✓</text>
      </view>
      <!-- 连线 -->
      <view wx:if="{{!item.last}}" class="timeline-line {{item.done && nextDone ? 'done' : 'pending'}}"></view>
      <!-- 内容 -->
      <view class="timeline-content">
        <text class="timeline-label {{item.done ? 'done' : 'pending'}}">{{item.label}}</text>
        <text wx:if="{{item.operator}}" class="timeline-operator">👤 {{item.operator}}</text>
      </view>
      <text wx:if="{{item.time}}" class="timeline-time">{{item.time}}</text>
    </view>
  </view>
</view>

<!-- ===== 操作日志 ===== -->
<view class="log-card">
  <view class="info-title">📝 操作日志</view>
  <view wx:if="{{order.logs && order.logs.length > 0}}">
    <view class="log-item" wx:for="{{order.logs}}" wx:key="index">
      <view class="log-left">
        <text class="log-operator">{{item.operator || '系统'}}</text>
        <text class="log-action">{{item.action}}</text>
      </view>
      <text class="log-time">{{item.time}}</text>
    </view>
  </view>
  <view wx:else class="log-empty">
    <text>暂无操作记录</text>
  </view>
</view>

<!-- ===== 底部操作按钮 ===== -->
<view class="bottom-action">
  <button wx:if="{{order.status === 4}}" class="action-btn primary" bindtap="goToEvaluate">
    去验收评价
  </button>
  <button wx:elif="{{order.status === 5}}" class="action-btn success" bindtap="goToEvaluate">
    查看评价
  </button>
  <button wx:else class="action-btn outline" bindtap="callContact" data-phone="{{order.contactPhone}}">
    📞 联系报修人
  </button>
</view>