<!-- ========== 历史设备复用提示 ========== -->
<view wx:if="{{showHistoryTip && historyDevices.length > 0}}" class="history-tip">
  <view class="history-tip-header">
    <text class="history-tip-icon">🔄</text>
    <text class="history-tip-title">检测到您曾报修过以下设备</text>
  </view>
  <view class="history-tip-body">
    <view 
      class="history-device-item" 
      wx:for="{{historyDevices}}" 
      wx:key="id"
      bindtap="reuseDevice" 
      data-index="{{index}}"
    >
      <view class="history-device-info">
        <text class="history-device-name">{{item.category}}</text>
        <text class="history-device-brand">{{item.brand}}</text>
        <text class="history-device-model">{{item.model}}</text>
      </view>
      <text class="history-device-time">{{item.time}}</text>
      <text class="history-device-reuse">复用 ›</text>
    </view>
  </view>
  <view class="history-tip-footer">
    <button class="history-tip-skip" bindtap="skipHistory">跳过，手动选择</button>
    <button class="history-tip-close" bindtap="closeHistoryTip">✕</button>
  </view>
</view>

<!-- ========== 步骤条 ========== -->
<view class="step-bar">
  <view class="step-item {{step >= 1 ? 'active' : ''}}">
    <view class="step-circle">1</view>
    <text class="step-label">选品类</text>
  </view>
  <view class="step-line {{step >= 2 ? 'active' : ''}}"></view>
  <view class="step-item {{step >= 2 ? 'active' : ''}}">
    <view class="step-circle">2</view>
    <text class="step-label">选品牌</text>
  </view>
  <view class="step-line {{step >= 3 ? 'active' : ''}}"></view>
  <view class="step-item {{step >= 3 ? 'active' : ''}}">
    <view class="step-circle">3</view>
    <text class="step-label">选型号</text>
  </view>
  <view class="step-line {{step >= 4 ? 'active' : ''}}"></view>
  <view class="step-item {{step >= 4 ? 'active' : ''}}">
    <view class="step-circle">4</view>
    <text class="step-label">填信息</text>
  </view>
</view>

<!-- ============================================================ -->
<!-- 第一步：选品类（只有不显示历史提示时才显示） -->
<!-- ============================================================ -->
<view wx:if="{{step === 1 && !showHistoryTip}}" class="step-content">
  <!-- 搜索框 -->
  <view class="search-box">
    <text class="search-icon">🔍</text>
    <input class="search-input" placeholder="搜索设备名称..." value="{{keyword}}" bindinput="onSearchInput" />
    <text wx:if="{{keyword}}" class="search-clear" bindtap="clearSearch">✕</text>
  </view>

  <view class="category-grid">
    <view 
      class="category-item {{selectedCategory === item.id ? 'selected' : ''}}"
      wx:for="{{filteredCategories}}" 
      wx:key="id"
      bindtap="selectCategory" 
      data-id="{{item.id}}"
    >
      <view class="category-icon" style="background: {{item.bg}};">{{item.icon}}</view>
      <text class="category-name">{{item.name}}</text>
      <text wx:if="{{selectedCategory === item.id}}" class="category-check">✓</text>
    </view>
  </view>

  <view wx:if="{{filteredCategories.length === 0}}" class="empty-state">
    <text class="empty-icon">🔍</text>
    <text class="empty-text">未找到匹配的品类</text>
  </view>

  <view class="bottom-btn">
    <button class="btn-next" disabled="{{!selectedCategory}}" bindtap="goToStep2">下一步</button>
  </view>
</view>

<!-- ============================================================ -->
<!-- 第二步：选品牌 -->
<!-- ============================================================ -->
<view wx:if="{{step === 2 && !showHistoryTip}}" class="step-content">
  <view class="step-header">
    <text class="step-header-title">已选：{{selectedCategoryName}}</text>
    <text class="step-header-change" bindtap="goToStep1">更换</text>
  </view>

  <view class="search-box">
    <text class="search-icon">🔍</text>
    <input class="search-input" placeholder="搜索品牌..." value="{{brandKeyword}}" bindinput="onBrandSearch" />
    <text wx:if="{{brandKeyword}}" class="search-clear" bindtap="clearBrandSearch">✕</text>
  </view>

  <view class="brand-grid">
    <view 
      class="brand-item {{selectedBrand === item ? 'selected' : ''}}"
      wx:for="{{filteredBrands}}" 
      wx:key="*this"
      bindtap="selectBrand" 
      data-name="{{item}}"
    >
      <text class="brand-name">{{item}}</text>
      <text wx:if="{{selectedBrand === item}}" class="brand-check">✓</text>
    </view>
  </view>

  <view class="custom-input-wrap">
    <text class="custom-label">或者输入品牌：</text>
    <input class="custom-input" placeholder="输入品牌名称" value="{{brandOther}}" bindinput="onBrandOtherInput" />
  </view>

  <view wx:if="{{filteredBrands.length === 0 && !brandOther}}" class="empty-state">
    <text class="empty-icon">🔍</text>
    <text class="empty-text">未找到匹配的品牌</text>
  </view>

  <view class="bottom-btn">
    <button class="btn-prev" bindtap="goToStep1">上一步</button>
    <button class="btn-next" disabled="{{!selectedBrand && !brandOther}}" bindtap="goToStep3">下一步</button>
  </view>
</view>

<!-- ============================================================ -->
<!-- 第三步：选型号 -->
<!-- ============================================================ -->
<view wx:if="{{step === 3 && !showHistoryTip}}" class="step-content">
  <view class="step-header">
    <text class="step-header-title">{{selectedCategoryName}} · {{selectedBrandName || brandOther}}</text>
    <text class="step-header-change" bindtap="goToStep2">更换</text>
  </view>

  <view class="search-box">
    <text class="search-icon">🔍</text>
    <input class="search-input" placeholder="搜索型号..." value="{{modelKeyword}}" bindinput="onModelSearch" />
    <text wx:if="{{modelKeyword}}" class="search-clear" bindtap="clearModelSearch">✕</text>
  </view>

  <view class="model-grid">
    <view 
      class="model-item {{selectedModel === item ? 'selected' : ''}}"
      wx:for="{{filteredModels}}" 
      wx:key="*this"
      bindtap="selectModel" 
      data-name="{{item}}"
    >
      <text class="model-name">{{item}}</text>
      <text wx:if="{{selectedModel === item}}" class="model-check">✓</text>
    </view>
  </view>

  <view class="custom-input-wrap">
    <text class="custom-label">或者输入型号：</text>
    <input class="custom-input" placeholder="输入型号名称" value="{{modelOther}}" bindinput="onModelOtherInput" />
  </view>

  <view wx:if="{{filteredModels.length === 0 && !modelOther}}" class="empty-state">
    <text class="empty-icon">🔍</text>
    <text class="empty-text">未找到匹配的型号</text>
  </view>

  <view class="bottom-btn">
    <button class="btn-prev" bindtap="goToStep2">上一步</button>
    <button class="btn-next" disabled="{{!selectedModel && !modelOther}}" bindtap="goToStep4">下一步</button>
  </view>
</view>

<!-- ============================================================ -->
<!-- 第四步：填信息 -->
<!-- ============================================================ -->
<view wx:elif="{{step === 4 && !showHistoryTip}}" class="step-content">
  <!-- ===== 归属门店（快速报修隐藏） ===== -->
  <view wx:if="{{false}}" class="store-card">
    <view class="store-icon">🏪</view>
    <view>
      <text class="store-label">归属门店</text>
      <text class="store-name">{{storeName}}</text>
    </view>
    <text class="store-badge">已绑定</text>
  </view>

  <!-- 已选设备信息 -->
  <view class="selected-info">
    <text class="selected-label">设备信息：</text>
    <text class="selected-tag">{{selectedCategoryName}}</text>
    <text class="selected-tag">{{selectedBrandName || brandOther || '未选'}}</text>
    <text class="selected-tag">{{selectedModelName || modelOther || '未选'}}</text>
  </view>

  <!-- 报修标题 -->
  <view class="input-card">
    <view class="info-title required">报修标题</view>
    <input class="form-input" placeholder="简单描述问题，如：3楼空调不制冷" value="{{title}}" bindinput="onTitleInput" />
  </view>

  <!-- 故障描述 -->
  <view class="input-card">
    <view class="info-title required">故障描述</view>
    <textarea class="form-textarea" placeholder="请详细描述故障现象，便于维修人员快速判断..." value="{{desc}}" bindinput="onDescInput" maxlength="500" />
    <view class="textarea-footer">
      <text class="char-count">{{desc.length}}/500</text>
    </view>

    <!-- 图片上传 -->
    <view class="upload-section">
      <view class="upload-grid">
        <view class="upload-item" wx:for="{{images}}" wx:key="index">
          <image src="{{item}}" mode="aspectFill" class="upload-image" />
          <view class="upload-delete" catchtap="deleteImage" data-index="{{index}}">✕</view>
        </view>
        <view wx:if="{{images.length < 9}}" class="upload-add" catchtap="chooseImage">
          <text class="upload-add-icon">+</text>
          <text class="upload-add-text">上传图片</text>
          <text class="upload-add-count">{{images.length}}/9</text>
        </view>
      </view>
      <text class="upload-tip">支持 JPG/PNG 格式，建议清晰拍摄故障部位</text>
    </view>
  </view>

  <!-- 报修地址 -->
  <view class="input-card">
    <view class="info-title required">报修地址</view>
    <view class="location-row" bindtap="getLocation">
      <text class="location-icon">📍</text>
      <text class="location-text">{{locationText || '点击获取当前位置'}}</text>
      <text class="location-action">定位</text>
    </view>
    <input class="form-input" placeholder="请手动输入详细地址（楼栋/房间号）" value="{{addressDetail}}" bindinput="onAddressDetailInput" />
    <view class="location-hint">
      <text>📍 已定位：{{locationAddress || '未定位'}}</text>
    </view>
  </view>

  <!-- 联系人信息 -->
  <view class="input-card">
    <view class="info-title required">联系人信息</view>
    <view class="contact-row">
      <view class="contact-field">
        <text class="contact-label">联系人</text>
        <input class="contact-input" placeholder="请输入姓名" value="{{contactName}}" bindinput="onContactNameInput" />
      </view>
      <view class="contact-field">
        <text class="contact-label">手机号</text>
        <input class="contact-input" type="number" placeholder="请输入手机号" value="{{contactPhone}}" bindinput="onContactPhoneInput" maxlength="11" />
      </view>
    </view>
    <view class="contact-tip">
      <text>✅ 已自动填充您的信息，可手动修改</text>
    </view>
  </view>

  <!-- 紧急程度 -->
  <view class="input-card">
    <view class="info-title required">紧急程度</view>
    <view class="urgency-grid">
      <view 
        class="urgency-item {{urgency === item.key ? 'active' : ''}}" 
        wx:for="{{urgencies}}" 
        wx:key="key"
        bindtap="selectUrgency" 
        data-key="{{item.key}}"
      >
        <view class="urgency-dot dot-{{item.key}}"></view>
        {{item.label}}
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-btns">
    <button class="btn-prev" bindtap="goToStep3">上一步</button>
    <button class="btn-submit" bindtap="submitForm">提交报修</button>
  </view>
</view>