/* ===== 筛选 Tab ===== */
.filter-tabs {
  display: flex;
  background: #ffffff;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.filter-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 28rpx 0 24rpx;
  font-size: 28rpx;
  color: #999999;
  position: relative;
}

.filter-tab.active {
  color: #07C160;
  font-weight: 600;
}

.filter-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #07C160;
  border-radius: 2rpx;
}

.tab-count {
  font-size: 22rpx;
  color: #07C160;
  background: #f0fdf4;
  padding: 0 12rpx;
  border-radius: 20rpx;
  min-width: 32rpx;
  text-align: center;
}

.filter-tab.active .tab-count {
  background: #07C160;
  color: #ffffff;
}

/* ===== 工单列表 ===== */
.order-list {
  padding: 16rpx 24rpx 40rpx;
}

.order-item {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 24rpx 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-tags {
  display: flex;
  gap: 12rpx;
}

.urgency-tag {
  font-size: 22rpx;
  padding: 2rpx 16rpx;
  border-radius: 20rpx;
}

.urgency-1 { background: #E8F5E9; color: #4CAF50; }
.urgency-2 { background: #FFF8E1; color: #FFA726; }
.urgency-3 { background: #FFF3E0; color: #FB8C00; }
.urgency-4 { background: #FFEBEE; color: #EF5350; }

.status-tag {
  font-size: 22rpx;
  padding: 2rpx 16rpx;
  border-radius: 20rpx;
}

.status-0 { background: #FFF8E1; color: #F57F17; }   /* 待审核 */
.status-1 { background: #E3F2FD; color: #0D47A1; }   /* 已派单 */
.status-2 { background: #E3F2FD; color: #0D47A1; }   /* 已接单 */
.status-3 { background: #FFF3E0; color: #E65100; }   /* 维修中 */
.status-4 { background: #F3E5F5; color: #7B1FA2; }   /* 待验收 */
.status-5 { background: #E8F5E9; color: #2E7D32; }   /* 已完成 */

.order-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
  margin-top: 12rpx;
}

.order-meta {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999999;
}

.order-meta-item {
  color: #999999;
}

.order-meta-divider {
  color: #e5e7eb;
}

.order-footer {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.progress-bar {
  flex: 1;
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.3s;
}

.order-time {
  font-size: 22rpx;
  color: #cccccc;
  flex-shrink: 0;
}

/* ===== 空状态 ===== */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
  display: block;
  margin-top: 16rpx;
}