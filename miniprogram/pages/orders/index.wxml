<!-- 筛选 Tab -->
<view class="filter-tabs">
  <view 
    class="filter-tab {{currentTab === 'all' ? 'active' : ''}}" 
    bindtap="switchTab" 
    data-tab="all"
  >
    <text>全部</text>
    <text class="tab-count" wx:if="{{tabCounts.all > 0}}">{{tabCounts.all}}</text>
  </view>
  <view 
    class="filter-tab {{currentTab === 'doing' ? 'active' : ''}}" 
    bindtap="switchTab" 
    data-tab="doing"
  >
    <text>进行中</text>
    <text class="tab-count" wx:if="{{tabCounts.doing > 0}}">{{tabCounts.doing}}</text>
  </view>
  <view 
    class="filter-tab {{currentTab === 'done' ? 'active' : ''}}" 
    bindtap="switchTab" 
    data-tab="done"
  >
    <text>已完成</text>
    <text class="tab-count" wx:if="{{tabCounts.done > 0}}">{{tabCounts.done}}</text>
  </view>
</view>

<!-- 工单列表 -->
<view class="order-list">
  <view 
    class="order-item" 
    wx:for="{{filteredOrders}}" 
    wx:key="id"
    bindtap="goToDetail" 
    data-id="{{item.id}}"
  >
    <!-- 头部：紧急标签 + 状态标签 -->
    <view class="order-header">
      <view class="order-tags">
        <text class="urgency-tag urgency-{{item.urgency}}">{{item.urgencyLabel}}</text>
        <text class="status-tag status-{{item.status}}">{{item.statusLabel}}</text>
      </view>
    </view>

    <!-- 标题 -->
    <text class="order-title">{{item.title}}</text>

    <!-- 设备/地址信息 -->
    <view class="order-meta">
      <text class="order-meta-item">{{item.category || '设备'}}</text>
      <text class="order-meta-divider">·</text>
      <text class="order-meta-item">{{item.brand || '品牌'}}</text>
      <text class="order-meta-divider">·</text>
      <text class="order-meta-item">{{item.location || item.address || '未指定地点'}}</text>
    </view>

    <!-- 底部：进度条 + 时间 -->
    <view class="order-footer">
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{item.progress}}%; background: {{item.barColor}};"></view>
      </view>
      <text class="order-time">{{item.createdAt}}</text>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{filteredOrders.length === 0}}" class="empty-state">
    <text class="empty-icon">📋</text>
    <text class="empty-text">{{currentTab === 'all' ? '暂无工单' : currentTab === 'doing' ? '暂无进行中的工单' : '暂无已完成的工单'}}</text>
  </view>
</view>