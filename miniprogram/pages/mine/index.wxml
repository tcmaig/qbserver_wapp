<!-- ===== 用户信息卡 ===== -->
<view class="user-card" bindtap="{{isLogin ? 'goToUserInfo' : 'showLoginModal'}}">
  <view class="user-avatar">
    <view wx:if="{{userInfo.avatar}}" class="avatar-img">
      <image src="{{userInfo.avatar}}" mode="aspectFill" />
    </view>
    <view wx:else class="avatar-fallback">
      <text class="avatar-text">{{userInfo.nickname || '用'}}</text>
    </view>
  </view>
  <view class="user-info">
    <view class="user-name-row">
      <text class="user-name">{{userInfo.nickname || '点击登录'}}</text>
      <text wx:if="{{isLogin}}" class="user-level">{{userInfo.level || '普通用户'}}</text>
    </view>
    <view class="user-store" catchtap="{{isLogin ? 'goToStoreList' : ''}}">
      <text class="store-icon">📍</text>
      <text class="store-name">{{storeName || '请绑定门店'}}</text>
      <text class="store-arrow" wx:if="{{isLogin}}">›</text>
    </view>
  </view>
  <text class="user-arrow">›</text>
</view>

<!-- ===== 工单统计 ===== -->
<view class="stats-card">
  <view class="stat-item" bindtap="goToOrders" data-status="all">
    <text class="stat-num">{{stats.all}}</text>
    <text class="stat-label">全部工单</text>
  </view>
  <view class="stat-item" bindtap="goToOrders" data-status="doing">
    <text class="stat-num">{{stats.doing}}</text>
    <text class="stat-label">进行中</text>
  </view>
  <view class="stat-item" bindtap="goToOrders" data-status="done">
    <text class="stat-num">{{stats.done}}</text>
    <text class="stat-label">已完成</text>
  </view>
  <view class="stat-item" bindtap="goToOrders" data-status="pending">
    <text class="stat-num">{{stats.pending}}</text>
    <text class="stat-label">待审核</text>
  </view>
</view>

<!-- ===== 功能菜单 ===== -->
<view class="menu-list">
  <view 
    class="menu-item" 
    wx:for="{{menus}}" 
    wx:key="label"
    bindtap="{{item.tap}}"
  >
    <text class="menu-icon color-{{item.color}}">{{item.icon}}</text>
    <text class="menu-label">{{item.label}}</text>
    <text wx:if="{{item.badge}}" class="menu-badge">{{item.badge > 99 ? '99+' : item.badge}}</text>
    <text class="menu-arrow">›</text>
  </view>
</view>

<!-- ===== 绑定手机号 ===== -->
<view class="phone-card">
  <view class="phone-item">
    <text class="phone-icon">📱</text>
    <text class="phone-label">绑定手机号</text>
    <text class="phone-number">{{userInfo.phone || '未绑定'}}</text>
    <text class="phone-action" bindtap="bindPhone">绑定</text>
  </view>
</view>

<!-- ===== 绑定门店 ===== -->
<view wx:if="{{isLogin}}" class="store-bind-section">
  <view class="store-bind-item" bindtap="goToStoreList">
    <text class="store-bind-icon">🏪</text>
    <text class="store-bind-label">绑定门店</text>
    <text class="store-bind-status">{{storeName || '未绑定'}}</text>
    <text class="store-bind-arrow">›</text>
  </view>
</view>

<!-- ===== 退出登录 ===== -->
<view wx:if="{{isLogin}}" class="logout-section">
  <button class="logout-btn" bindtap="logout">退出登录</button>
</view>

<!-- ===== 登录弹窗 ===== -->
<view wx:if="{{showModal}}" class="login-modal-mask" bindtap="closeModal">
  <view class="login-modal" catchtap="stopPropagation">
    <view class="login-modal-title">🔑 微信登录</view>
    <view class="login-modal-desc">授权后自动绑定手机号，快速报修</view>
    <button 
      class="login-modal-btn"
      open-type="getPhoneNumber"
      bindgetphonenumber="getPhoneNumber"
    >
      微信一键登录
    </button>
    <text class="login-modal-cancel" bindtap="closeModal">取消</text>
  </view>
</view>