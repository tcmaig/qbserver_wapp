/* ===== 用户信息卡 ===== */
.user-card {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx;
  background: #ffffff;
  margin: 20rpx 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 24rpx;
  background: #f0fdf4;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-img image {
  width: 100%;
  height: 100%;
}

.avatar-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f0fdf4;
}

.avatar-text {
  font-size: 40rpx;
  font-weight: 600;
  color: #07C160;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.user-level {
  font-size: 20rpx;
  color: #07C160;
  background: #f0fdf4;
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
}

.user-store {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
}

.store-icon {
  font-size: 24rpx;
}

.store-name {
  font-size: 24rpx;
  color: #999;
}

.store-arrow {
  font-size: 24rpx;
  color: #ccc;
}

.user-arrow {
  font-size: 36rpx;
  color: #d1d5db;
}

/* ===== 工单统计 ===== */
.stats-card {
  display: flex;
  background: #ffffff;
  margin: 0 24rpx 20rpx;
  border-radius: 24rpx;
  padding: 28rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.stat-item {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #f3f4f6;
}

.stat-item:last-child {
  border-right: none;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: block;
}

.stat-label {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 6rpx;
  display: block;
}

/* ===== 菜单列表 ===== */
.menu-list {
  background: #ffffff;
  margin: 0 24rpx 20rpx;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 32rpx;
  width: 48rpx;
  text-align: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.color-sky-500 { color: #0ea5e9; }
.color-emerald-500 { color: #10b981; }
.color-indigo-500 { color: #6366f1; }
.color-rose-500 { color: #f43f5e; }
.color-gray-500 { color: #6b7280; }
.color-amber-500 { color: #f59e0b; }
.color-purple-500 { color: #8b5cf6; }

.menu-label {
  flex: 1;
  font-size: 28rpx;
  color: #1f2937;
}

.menu-badge {
  font-size: 22rpx;
  color: #ffffff;
  background: #ef4444;
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
  margin-right: 12rpx;
}

.menu-arrow {
  font-size: 32rpx;
  color: #d1d5db;
}

/* ===== 绑定手机号 ===== */
.phone-card {
  background: #ffffff;
  margin: 0 24rpx 20rpx;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  overflow: hidden;
}

.phone-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
}

.phone-icon {
  font-size: 32rpx;
  width: 48rpx;
  text-align: center;
  margin-right: 20rpx;
  color: #9ca3af;
  flex-shrink: 0;
}

.phone-label {
  flex: 1;
  font-size: 28rpx;
  color: #1f2937;
}

.phone-number {
  font-size: 24rpx;
  color: #9ca3af;
  margin-right: 12rpx;
}

.phone-action {
  font-size: 24rpx;
  color: #07C160;
}

/* ===== 绑定门店 ===== */
.store-bind-section {
  margin: 0 24rpx 20rpx;
}

.store-bind-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.store-bind-icon {
  font-size: 32rpx;
  width: 48rpx;
  text-align: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.store-bind-label {
  flex: 1;
  font-size: 28rpx;
  color: #1f2937;
}

.store-bind-status {
  font-size: 24rpx;
  color: #07C160;
  margin-right: 12rpx;
}

.store-bind-arrow {
  font-size: 32rpx;
  color: #d1d5db;
}

/* ===== 退出登录 ===== */
.logout-section {
  padding: 0 24rpx 40rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  background: #ffffff;
  color: #ef4444;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logout-btn::after {
  border: none;
}

/* ===== 登录弹窗 ===== */
.login-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.login-modal {
  width: 560rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 48rpx 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.login-modal-desc {
  font-size: 26rpx;
  color: #999;
  margin-top: 12rpx;
  text-align: center;
}

.login-modal-btn {
  width: 100%;
  height: 88rpx;
  background: #07C160;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-modal-btn::after {
  border: none;
}

.login-modal-cancel {
  font-size: 26rpx;
  color: #999;
  margin-top: 20rpx;
}