<!-- 商城横幅 -->
<view class="mall-banner">
  <view class="mall-banner-content">
    <text class="mall-banner-title">门店采购 · 次日达</text>
    <text class="mall-banner-sub">配件、耗材、照明一站购齐</text>
  </view>
  <view class="mall-banner-cart" bindtap="goToCart">
    <text class="cart-icon">🛒</text>
    <view wx:if="{{cartCount > 0}}" class="cart-badge">{{cartCount > 99 ? '99+' : cartCount}}</view>
  </view>
</view>

<!-- 分类 -->
<view class="mall-categories">
  <!-- 左侧主分类 -->
  <scroll-view class="category-left" scroll-y="{{true}}">
    <view 
      class="category-left-item {{mainKey === item.id ? 'active' : ''}}" 
      wx:for="{{categories}}" 
      wx:key="id"
      bindtap="selectMain" 
      data-key="{{item.id}}"
    >
      <text>{{item.title}}</text>
    </view>
  </scroll-view>

  <!-- 右侧子分类 -->
  <scroll-view class="category-right" scroll-y="{{true}}">
    <view class="sub-section" wx:for="{{subCategories}}" wx:key="id">
      <view class="sub-header" bindtap="openSubCategory" data-id="{{item.id}}" data-title="{{item.title}}">
        <text class="sub-title">{{item.title}}</text>
        <text class="sub-arrow">›</text>
      </view>
    </view>
    <view wx:if="{{subCategories.length === 0}}" class="sub-empty">
      <text>暂无子分类</text>
    </view>
  </scroll-view>
</view>

<!-- 商品列表 -->
<view class="product-list">
  <view class="product-section-title">推荐商品</view>
  <view class="product-grid">
    <view 
      class="product-card" 
      wx:for="{{products}}" 
      wx:key="id"
      bindtap="goToProductDetail" 
      data-id="{{item.id}}"
    >
      <view class="product-image">
        <image wx:if="{{item.thumbnail}}" src="{{item.thumbnail}}" mode="aspectFill" class="product-image-src" />
        <view wx:else class="product-image-placeholder">📦</view>
        <view wx:if="{{item.discount}}" class="product-tag">{{item.discount}}折</view>
      </view>
      <view class="product-info">
        <text class="product-name">{{item.name}}</text>
        <text class="product-spec">{{item.spec}}</text>
        <view class="product-bottom">
          <text class="product-price">{{item.price ? '¥' + item.price : '询价'}}</text>
          <view class="product-cart-btn" catchtap="addToCart" data-id="{{item.id}}">
            <text>+</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载更多 -->
  <view wx:if="{{loading}}" class="loading-more">加载中...</view>
  <view wx:if="{{!hasMore && products.length > 0}}" class="no-more">已加载全部商品</view>
</view>