.register-header {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  background: #fff;
  margin: 20rpx 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}

.register-header-icon {
  font-size: 40rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.register-header-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
}

.register-header-sub {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
  line-height: 1.5;
}

.form-card {
  background: #fff;
  margin: 16rpx 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}

.info-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  padding-left: 16rpx;
  border-left: 4rpx solid #07C160;
}

.info-title.required::after {
  content: '*';
  color: #EF4444;
  margin-left: 4rpx;
}

.picker-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 16rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #1a1a1a;
}

.picker-display .picker-arrow {
  color: #999;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 16rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin-top: 12rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  font-size: 26rpx;
  margin-top: 12rpx;
  box-sizing: border-box;
}

.form-hint {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 8rpx;
}

.bottom-submit {
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  margin-top: 20rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: #07C160;
  color: #fff;
  border: none;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.submit-btn::after {
  border: none;
}