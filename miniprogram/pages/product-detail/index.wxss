.product-image-wrapper {
  background: #fff;
  padding: 40rpx;
  display: flex;
  justify-content: center;
}

.product-image-big {
  width: 400rpx;
  height: 400rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-icon-big {
  font-size: 120rpx;
}

.bg-sky-50 { background: #EFF6FF; }
.bg-cyan-50 { background: #ECFEFF; }
.bg-emerald-50 { background: #ECFDF5; }
.bg-amber-50 { background: #FFFBEB; }

.product-info-card {
  background: #fff;
  margin: 16rpx 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}

.product-price-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.product-price-big {
  font-size: 44rpx;
  font-weight: 700;
  color: #07C160;
}

.product-price-original {
  font-size: 26rpx;
  color: #999;
  text-decoration: line-through;
}

.product-price-discount {
  font-size: 22rpx;
  color: #fff;
  background: #EF4444;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}

.product-name-big {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
  margin-top: 12rpx;
}

.product-spec-big {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.product-meta-row {
  display: flex;
  gap: 20rpx;
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f5f5f5;
}

.in-stock { color: #07C160; }
.out-stock { color: #EF4444; }

.product-detail-card {
  background: #fff;
  margin: 16rpx 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}

.detail-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  padding-left: 16rpx;
  border-left: 4rpx solid #07C160;
}

.detail-text {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-top: 12rpx;
  line-height: 1.6;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
}

.bottom-cart {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bottom-cart-icon {
  font-size: 44rpx;
}

.bottom-cart-badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  min-width: 32rpx;
  height: 32rpx;
  background: #EF4444;
  color: #fff;
  font-size: 20rpx;
  border-radius: 16rpx;
  text-align: center;
  line-height: 32rpx;
  padding: 0 6rpx;
}

.bottom-actions {
  flex: 1;
  display: flex;
  gap: 16rpx;
}

.bottom-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bottom-btn::after {
  border: none;
}

.bottom-btn.outline {
  background: #f0fdf4;
  color: #07C160;
  border: 1rpx solid #07C160;
}

.bottom-btn.primary {
  background: #07C160;
  color: #fff;
}