<!-- 商品图片 -->
<view class="product-image-wrapper">
  <view class="product-image-big bg-{{product.bg}}">
    <text class="product-icon-big">{{product.icon}}</text>
  </view>
</view>

<!-- 商品信息 -->
<view class="product-info-card">
  <view class="product-price-row">
    <text class="product-price-big">¥{{product.price}}</text>
    <text wx:if="{{product.originalPrice}}" class="product-price-original">¥{{product.originalPrice}}</text>
    <text wx:if="{{product.discount}}" class="product-price-discount">{{product.discount}}折</text>
  </view>
  <text class="product-name-big">{{product.name}}</text>
  <text class="product-spec-big">{{product.spec}}</text>
  <view class="product-meta-row">
    <text>已售 {{product.sold}} 件</text>
    <text wx:if="{{product.inStock}}" class="in-stock">✓ 有货</text>
    <text wx:else class="out-stock">补货中</text>
  </view>
</view>

<!-- 商品详情 -->
<view class="product-detail-card">
  <view class="detail-title">商品详情</view>
  <text class="detail-text">{{product.detail || '暂无详情描述'}}</text>
</view>

<!-- 底部操作栏 -->
<view class="bottom-bar">
  <view class="bottom-cart" bindtap="goToCart">
    <text class="bottom-cart-icon">🛒</text>
    <text wx:if="{{cartCount > 0}}" class="bottom-cart-badge">{{cartCount > 99 ? '99+' : cartCount}}</text>
  </view>
  <view class="bottom-actions">
    <button class="bottom-btn outline" bindtap="addToCart" data-id="{{product.id}}">加入购物车</button>
    <button class="bottom-btn primary" bindtap="buyNow" data-id="{{product.id}}">立即购买</button>
  </view>
</view>