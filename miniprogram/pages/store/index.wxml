<view class="store-header">
  <text class="store-header-title">选择你的门店</text>
  <text class="store-header-sub">绑定后，报修工单将自动归属于该门店</text>
</view>

<view class="store-list">
  <view 
    class="store-item {{item.bound ? 'bound' : ''}}" 
    wx:for="{{stores}}" 
    wx:key="id"
    bindtap="bindStore" 
    data-id="{{item.id}}"
  >
    <view class="store-icon">📍</view>
    <view class="store-info">
      <view class="store-name-row">
        <text class="store-name">{{item.name}}</text>
        <text wx:if="{{item.bound}}" class="store-bound">✓ 当前绑定</text>
      </view>
      <text class="store-address">{{item.address}}</text>
      <view class="store-meta">
        <text>🔍 {{item.distance}}</text>
        <text>📞 {{item.phone}}</text>
      </view>
    </view>
    <view class="store-action">
      <text wx:if="{{item.bound}}" class="store-checked">✓</text>
      <text wx:else class="store-bind">绑定</text>
    </view>
  </view>
</view>

<!-- 登记新店 -->
<view class="register-btn" bindtap="goToRegister">
  <text class="register-icon">+</text>
  <view>
    <text class="register-title">找不到你的门店？</text>
    <text class="register-sub">选择地址并登记新店，登记后即可绑定</text>
  </view>
</view>

<text class="store-tip">已登记门店会作为「当前绑定」生效；若需新增/下线门店，由管理端统一维护。</text>