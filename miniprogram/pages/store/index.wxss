.store-header {
  background: #fff;
  margin: 20rpx 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}

.store-header-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
}

.store-header-sub {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.store-list {
  background: #fff;
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.store-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.store-item:last-child {
  border-bottom: none;
}

.store-item.bound {
  background: #f0fdf4;
}

.store-icon {
  font-size: 36rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.store-info {
  flex: 1;
  min-width: 0;
}

.store-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.store-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
}

.store-bound {
  font-size: 20rpx;
  color: #07C160;
  background: #f0fdf4;
  padding: 2rpx 12rpx;
  border-radius: 12rpx;
}

.store-address {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.store-meta {
  display: flex;
  gap: 20rpx;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999;
}

.store-action {
  flex-shrink: 0;
  margin-top: 4rpx;
}

.store-checked {
  width: 40rpx;
  height: 40rpx;
  background: #07C160;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.store-bind {
  font-size: 24rpx;
  color: #07C160;
}

.register-btn {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 16rpx 24rpx;
  padding: 24rpx;
  border: 2rpx dashed #07C160;
  border-radius: 16rpx;
  background: #f0fdf4;
}

.register-icon {
  font-size: 36rpx;
  color: #07C160;
}

.register-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #07C160;
  display: block;
}

.register-sub {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 2rpx;
}

.store-tip {
  display: block;
  font-size: 22rpx;
  color: #999;
  padding: 16rpx 24rpx;
}