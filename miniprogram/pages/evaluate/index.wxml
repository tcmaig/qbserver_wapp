<!-- ===== 完成横幅 ===== -->
<view class="complete-banner">
  <view class="complete-icon">✅</view>
  <view class="complete-content">
    <text class="complete-title">维修已完成</text>
    <text class="complete-sub">请确认维修结果并评价，帮助提升服务质量</text>
  </view>
</view>

<!-- ===== 工单信息 ===== -->
<view class="order-info-card">
  <view class="order-info-row">
    <text class="order-info-title">{{order.title}}</text>
    <text class="order-info-link" bindtap="goToDetail">查看详情</text>
  </view>
  <view class="order-info-meta">
    <text>{{order.id}}</text>
    <text class="divider">·</text>
    <text>{{order.storeName || '未指定门店'}}</text>
    <text class="divider">·</text>
    <text>{{order.location || '未指定地点'}}</text>
  </view>
</view>

<!-- ===== 维修摘要 ===== -->
<view class="summary-card">
  <view class="info-title">🔧 维修摘要</view>
  <view wx:if="{{order.summary}}" class="summary-content">
    <view class="summary-row">
      <text class="summary-label">故障原因</text>
      <text class="summary-value">{{order.summary.cause || '未记录'}}</text>
    </view>
    <view class="summary-row">
      <text class="summary-label">处理方法</text>
      <text class="summary-value">{{order.summary.method || '未记录'}}</text>
    </view>
    <view class="summary-row">
      <text class="summary-label">更换备件</text>
      <text class="summary-value">{{order.summary.parts || '无'}}</text>
    </view>
    <view class="summary-row">
      <text class="summary-label">维修耗时</text>
      <text class="summary-value">{{order.summary.duration || '未记录'}}</text>
    </view>
    <view class="summary-row cost-row">
      <text class="summary-label">维修费用</text>
      <text class="summary-value cost">{{order.summary.cost || '¥0.00'}}</text>
    </view>
  </view>
  <view wx:else class="summary-empty">
    <text>暂无维修摘要信息</text>
  </view>
</view>

<!-- ===== 维修后照片 ===== -->
<view class="photos-card">
  <view class="info-title">📷 维修后照片</view>
  <view wx:if="{{order.afterImages && order.afterImages.length > 0}}" class="photos-grid">
    <image 
      wx:for="{{order.afterImages}}" 
      wx:key="index"
      src="{{item}}" 
      mode="aspectFill" 
      class="photo-item"
      bindtap="previewImage" 
      data-url="{{item}}"
    />
  </view>
  <view wx:else class="photos-empty">
    <text class="photos-empty-icon">📷</text>
    <text class="photos-empty-text">暂无维修后照片</text>
  </view>
</view>

<!-- ===== 满意度评分 ===== -->
<view class="rating-card">
  <view class="info-title">⭐ 满意度评分</view>
  <view class="stars">
    <text 
      class="star {{index <= rating ? 'active' : ''}}" 
      wx:for="{{5}}" 
      wx:key="index"
      bindtap="setRating" 
      data-index="{{index}}"
    >★</text>
  </view>
  <text class="rating-label">{{ratingLabels[rating] || '请评分'}}</text>
</view>

<!-- ===== 文字评价 ===== -->
<view class="comment-card">
  <view class="info-title">
    评价 <text class="comment-optional">（选填）</text>
  </view>
  <textarea 
    class="comment-input" 
    placeholder="说说这次维修体验吧..." 
    maxlength="200"
    value="{{comment}}"
    bindinput="onCommentInput"
  />
  <text class="comment-count">{{comment.length}}/200</text>
</view>

<!-- ===== 底部操作按钮 ===== -->
<view class="bottom-actions">
  <button class="action-btn reject" bindtap="rejectOrder">退回重修</button>
  <button class="action-btn confirm" disabled="{{rating === 0}}" bindtap="confirmOrder">确认完成</button>
</view>
<view wx:if="{{rating === 0}}" class="rating-tip">请先完成满意度评分</view>