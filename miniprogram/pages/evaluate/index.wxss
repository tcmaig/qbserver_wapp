/* ===== 完成横幅 ===== */
.complete-banner {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: linear-gradient(135deg, #07C160, #059669);
  padding: 32rpx 30rpx;
  border-radius: 16rpx;
  margin: 20rpx 24rpx;
}

.complete-icon {
  font-size: 48rpx;
  flex-shrink: 0;
}

.complete-content {
  flex: 1;
}

.complete-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  display: block;
}

.complete-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
  display: block;
  margin-top: 4rpx;
}

/* ===== 工单信息 ===== */
.order-info-card {
  background: #ffffff;
  margin: 16rpx 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}

.order-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-info-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
}

.order-info-link {
  font-size: 24rpx;
  color: #07C160;
  padding: 8rpx 16rpx;
}

.order-info-meta {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.divider {
  color: #e5e7eb;
}

/* ===== 维修摘要 ===== */
.summary-card {
  background: #ffffff;
  margin: 16rpx 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}

.photos-card {
  background: #ffffff;
  margin: 16rpx 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}

.rating-card {
  background: #ffffff;
  margin: 16rpx 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}

.comment-card {
  background: #ffffff;
  margin: 16rpx 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 140rpx;
}

.info-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  padding-left: 16rpx;
  border-left: 4rpx solid #07C160;
}

/* ===== 维修摘要内容 ===== */
.summary-content {
  margin-top: 16rpx;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.summary-row:last-child {
  border-bottom: none;
}

.summary-label {
  font-size: 26rpx;
  color: #999;
}

.summary-value {
  font-size: 26rpx;
  color: #1a1a1a;
  text-align: right;
  margin-left: 16rpx;
}

.cost-row .cost {
  color: #F97316;
  font-weight: 600;
  font-size: 28rpx;
}

.summary-empty {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 20rpx 0;
}

/* ===== 维修后照片 ===== */
.photos-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 16rpx;
}

.photo-item {
  width: 100%;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
}

.photos-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 0;
  color: #999;
}

.photos-empty-icon {
  font-size: 48rpx;
}

.photos-empty-text {
  font-size: 24rpx;
  margin-top: 8rpx;
}

/* ===== 满意度评分 ===== */
.stars {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  justify-content: center;
}

.star {
  font-size: 56rpx;
  color: #e5e7eb;
  transition: color 0.2s;
  padding: 4rpx;
}

.star.active {
  color: #FBBF24;
}

.rating-label {
  display: block;
  text-align: center;
  font-size: 28rpx;
  color: #999;
  margin-top: 12rpx;
}

/* ===== 文字评价 ===== */
.comment-optional {
  font-size: 22rpx;
  font-weight: 400;
  color: #999;
}

.comment-input {
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx;
  background: #f9fafb;
  border-radius: 12rpx;
  font-size: 26rpx;
  margin-top: 12rpx;
  box-sizing: border-box;
}

.comment-count {
  font-size: 22rpx;
  color: #ccc;
  display: block;
  text-align: right;
  margin-top: 6rpx;
}

/* ===== 底部按钮 ===== */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #f0f0f0;
  z-index: 10;
}

.rating-tip {
  position: fixed;
  bottom: 120rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 24rpx;
  color: #EF4444;
  padding: 8rpx 0;
  background: #FEF2F2;
  z-index: 9;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn::after {
  border: none;
}

.action-btn.confirm {
  background: #07C160;
  color: #ffffff;
}

.action-btn.confirm[disabled] {
  background: #d1d5db;
  color: #999;
}

.action-btn.reject {
  background: #ffffff;
  color: #EF4444;
  border: 1rpx solid #EF4444;
}

.action-btn.reject::after {
  border: none;
}