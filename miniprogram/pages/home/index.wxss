/* 顶部导航 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx 16rpx;
  background: #ffffff;
}

.header-left {
  display: flex;
  align-items: center;
}

.store-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.store-arrow {
  font-size: 22rpx;
  color: #999;
  margin-left: 8rpx;
}

.header-right {
  position: relative;
}

.icon-bell {
  font-size: 44rpx;
}

.badge-dot {
  position: absolute;
  top: -6rpx;
  right: -10rpx;
  min-width: 32rpx;
  height: 32rpx;
  background: #ef4444;
  color: #ffffff;
  font-size: 20rpx;
  border-radius: 16rpx;
  text-align: center;
  line-height: 32rpx;
  padding: 0 6rpx;
}

/* Banner */
.banner-wrapper {
  padding: 0 30rpx;
  margin-top: 12rpx;
}

.banner-swiper {
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

/* 每个 swiper-item 内部的容器 */
.banner-item-inner {
  height: 100%;
  width: 100%;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  flex-direction: column;
  padding: 16rpx 30rpx 12rpx;
  box-sizing: border-box;
}

/* 三种颜色 */
.banner-bg-0 { background: linear-gradient(135deg, #e09a2f, #be7303); }
.banner-bg-1 { background: linear-gradient(135deg, #0EA5E9, #0284C7); }
.banner-bg-2 { background: linear-gradient(135deg, #10B981, #059669); }

.banner-content {
  display: flex;
  flex-direction: column;
}

.banner-tag {
  display: inline-block;
  padding: 4rpx 18rpx;
  background: rgba(255,255,255,0.2);
  color: #ffffff;
  font-size: 20rpx;
  border-radius: 20rpx;
  width: fit-content;
  margin-bottom: 8rpx;
}

.banner-title {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.3;
}

.banner-sub {
  color: rgba(255,255,255,0.85);
  font-size: 22rpx;
  margin-top: 4rpx;
}

/* 金刚区 */
.kengang {
  display: flex;
  gap: 20rpx;
  padding: 0 30rpx;
  margin-top: 20rpx;
}

.kengang-left {
  flex: 1.2;
  background: linear-gradient(135deg,  #42c9f1, #09a4ec);
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 160rpx;
}

.kengang-left-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.kengang-left-icon {
  font-size: 40rpx;
}

.kengang-left-title {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
}

.kengang-left-sub {
  color: rgba(255,255,255,0.85);
  font-size: 24rpx;
}

.kengang-right {
  flex: 1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.kengang-item {
  background: #f8fafc;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #333;
}

.kengang-item-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.icon-install { background: #E3F2FD; }
.icon-purchase { background: #F3E5F5; }
.icon-maintain { background: #FFF3E0; }
.icon-material { background: #FCE4EC; }

/* 我的工单 */
.order-section {
  padding: 0 30rpx;
  margin-top: 28rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.section-more {
  font-size: 24rpx;
  color: #999;
}

.stats-row {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 0;
}

.stats-item {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid #f3f4f6;
}

.stats-item:last-child {
  border-right: none;
}

.stats-number {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a1a;
  display: block;
}

.stats-label {
  font-size: 22rpx;
  color: #9ca3af;
  display: block;
  margin-top: 4rpx;
}

.orders-list {
  background: #ffffff;
  border-radius: 16rpx;
  margin-top: 4rpx;
}

.order-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-item:last-child {
  border-bottom: none;
}

.order-left {
  flex: 1;
  min-width: 0;
}

.order-title {
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 500;
  display: block;
}

.order-location {
  font-size: 22rpx;
  color: #9ca3af;
  display: block;
  margin-top: 4rpx;
}

.order-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.order-status {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.status-accept { background: #F3E5F5; color: #7B1FA2; }
.status-repair { background: #FFF3E0; color: #E65100; }
.status-dispatched { background: #E3F2FD; color: #0D47A1; }
.status-pending { background: #FFF8E1; color: #F57F17; }
.status-done { background: #E8F5E9; color: #2E7D32; }
.status-rejected { background: #FFEBEE; color: #C62828; }
.status-closed { background: #F5F5F5; color: #757575; }
.status-accepted { background: #E3F2FD; color: #0D47A1; }

.order-time {
  font-size: 20rpx;
  color: #b0b0b0;
  margin-top: 4rpx;
}

/* 常用功能 */
.tools-section {
  padding: 0 30rpx;
  margin-top: 28rpx;
  margin-bottom: 30rpx;
}

.tools-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  background: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx 0;
  margin-top: 16rpx;
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 0;
}

.tool-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.bg-sky-50 { background: #EFF6FF; }
.bg-emerald-50 { background: #ECFDF5; }
.bg-indigo-50 { background: #EEF2FF; }
.bg-rose-50 { background: #FFF1F2; }

.tool-label {
  font-size: 22rpx;
  color: #666;
}